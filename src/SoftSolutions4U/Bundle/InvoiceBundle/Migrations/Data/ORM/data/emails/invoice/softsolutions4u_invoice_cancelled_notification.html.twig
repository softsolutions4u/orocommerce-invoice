{#
    @name = softsolutions4u_invoice_cancelled_notification
    @entityName = SoftSolutions4U\Bundle\InvoiceBundle\Entity\Invoice
    @subject = Your invoice {{ entity.invoiceNo|default('') }} has been cancelled
    @isSystem = true
    @isEditable = true
#}

{% extends oro_get_email_template('base_storefront') %}

{% block content %}
    <h1 style="{{ styleH1 }}">Hello {{ entity.customerUser|oro_format_name }},</h1>

    <!--empty space-->
    <table role="presentation" border="0" cellspacing="0" cellpadding="0">
        <tr>
            <td height="12" style="{{ styleEmptyRowH12 }}">&nbsp;</td>
        </tr>
    </table>

    <p style="{{ styleP }}">Your invoice {{ entity.invoiceNo|default('') }} has been cancelled.</p>

    <!--empty space-->
    <table role="presentation" border="0" cellspacing="0" cellpadding="0">
        <tr>
            <td height="32" style="{{ styleEmptyRowH32 }}">&nbsp;</td>
        </tr>
    </table>

    <!--info section-->
    <table class="two-columns" role="presentation" border="0" cellspacing="0" cellpadding="0" width="100%">
        <tr>
            <!--left column-->
            <td class="table-column" width="50%" valign="top" style="padding-right: 36px;">
                <table role="presentation" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td style="{{ styleInfoItem }}">
                            <p style="{{ styleLabel }}">Invoice No.</p>
                            <p style="{{ styleValue }}">{{ entity.invoiceNo|default('') }}</p>
                        </td>
                    </tr>
                    {% if entity.order %}
                        <tr>
                            <td style="{{ styleInfoItem }}">
                                <p style="{{ styleLabel }}">Order No.</p>
                                <p style="{{ styleValue }}">{{ entity.order.identifier|default('') }}</p>
                            </td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td style="{{ styleInfoItem }}">
                            <p style="{{ styleLabel }}">Issue Date</p>
                            <p style="{{ styleValue }}">{{ entity.issueDate ? entity.issueDate|oro_format_date({dateType: 'short'}) : '&mdash;' }}</p>
                        </td>
                    </tr>
                    {% if entity.poNumber %}
                        <tr>
                            <td style="{{ styleInfoItem }}">
                                <p style="{{ styleLabel }}">PO Number</p>
                                <p style="{{ styleValue }}">{{ entity.poNumber|default('') }}</p>
                            </td>
                        </tr>
                    {% endif %}
                </table>
            </td>

            <!--right column-->
            <td class="table-column" width="50%" valign="top" style="padding-left: 36px;">
                <table role="presentation" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td style="{{ styleInfoItem }}">
                            <p style="{{ styleLabel }}">Billing Address</p>
                            <p style="{{ styleValue }}">
                                {% if entity.billingAddressFirstName or entity.billingAddressLastName %}{{ entity.billingAddressFirstName }} {{ entity.billingAddressLastName }}<br/>{% endif %}
                                {% if entity.billingAddressOrganization %}{{ entity.billingAddressOrganization }}<br/>{% endif %}
                                {% if entity.billingAddressStreet1 %}{{ entity.billingAddressStreet1 }}<br/>{% endif %}
                                {% if entity.billingAddressStreet2 %}{{ entity.billingAddressStreet2 }}<br/>{% endif %}
                                {% if entity.billingAddressCity or entity.billingAddressState or entity.billingAddressPostalCode %}
                                    {{ entity.billingAddressCity }}{% if entity.billingAddressCity and entity.billingAddressState %}, {% endif %}{{ entity.billingAddressState }} {{ entity.billingAddressPostalCode }}<br/>
                                {% endif %}
                                {% if entity.billingAddressCountry %}{{ entity.billingAddressCountry }}<br/>{% endif %}
                                {% if entity.billingAddressPhone %}{{ entity.billingAddressPhone }}{% endif %}
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!--empty space-->
    <table role="presentation" border="0" cellspacing="0" cellpadding="0">
        <tr>
            <td height="32" style="{{ styleEmptyRowH32 }}">&nbsp;</td>
        </tr>
    </table>

    <p style="{{ styleP }}">If you have any questions, please contact us.</p>
{% endblock content %}
