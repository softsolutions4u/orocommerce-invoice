{% set productId = record.getValue('productId') %}
{% set productName = record.getValue('product') %}
{% set productSku = record.getValue('sku') %}

<h3 class="oro-grid-table__title">
    {% if productId %}
        <a class="oro-grid-table__link no-decoration" href="{{ path('oro_product_frontend_product_view', {id: productId}) }}">{{ productName }}</a>
    {% else %}
        {{ productName }}
    {% endif %}
</h3>

{% if productSku %}
    <div class="customer-line-items__row">
        {{ 'softsolutions4u.invoice.frontend.line_item.sku.label'|trans }}: <span class="customer-line-items__sku-value">{{ productSku }}</span>
    </div>
{% endif %}
